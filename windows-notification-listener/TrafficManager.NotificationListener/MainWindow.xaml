<Window x:Class="TrafficManager.NotificationListener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Manager Notification Listener"
        Width="420"
        Height="520"
        MinWidth="380"
        MinHeight="420"
        Background="#11141A"
        Foreground="#E6EDF3">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1C2128" />
      <Setter Property="Foreground" Value="#E6EDF3" />
      <Setter Property="BorderBrush" Value="#30363D" />
      <Setter Property="Padding" Value="6" />
    </Style>
  </Window.Resources>
  <ScrollViewer Padding="16">
    <StackPanel>
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Traffic Manager Notification Listener" />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="Для чтения уведомлений Slack нужно разрешение Windows." />

      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Windows notification access" />
      <TextBlock x:Name="AccessLabel" Text="○ Not allowed" />
      <Button x:Name="AllowButton" Content="Разрешить доступ" Click="AllowButton_Click" />
      <TextBlock x:Name="DeniedHint" Margin="0,6,0,0" Foreground="#D29922" TextWrapping="Wrap" Visibility="Collapsed"
                 Text="Разрешите доступ к уведомлениям в настройках Windows." />

      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Slack notifications" />
      <TextBlock x:Name="SlackLabel" Text="○ Waiting" />

      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Backend" />
      <TextBlock x:Name="BackendLabel" Text="● http://127.0.0.1:8000" />

      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Last Slack notification" />
      <TextBlock x:Name="LastLabel" Text="—" />

      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Local token" />
      <PasswordBox x:Name="TokenBox" />
      <TextBox x:Name="BackendUrlBox" Margin="0,8,0,0" />
      <TextBlock Margin="0,16,0,4" Foreground="#8B949E" Text="Optional Slack source ids" />
      <TextBox x:Name="SourceIdsBox" Margin="0,0,0,0" />
      <Button Content="Сохранить настройки" Click="SaveButton_Click" />

      <CheckBox x:Name="DiscoveryBox" Margin="0,14,0,0" Foreground="#E6EDF3" Content="Discovery mode" Checked="FlagChanged" Unchecked="FlagChanged" />
      <CheckBox x:Name="DebugBox" Margin="0,6,0,0" Foreground="#E6EDF3" Content="Debug (show last Slack text)" Checked="FlagChanged" Unchecked="FlagChanged" />
      <TextBlock x:Name="DebugLabel" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      <ItemsControl x:Name="DiscoveryList" Margin="0,10,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
