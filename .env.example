# Copy this file to .env and fill in local values.
# Never commit .env or put API keys in the frontend.

APP_NAME=Traffic Manager Assistant
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# mock | real
TYPEX_MODE=mock
# TypeX Desktop MCP endpoint.
# Verify against the installed TypeX version before enabling TYPEX_MODE=real.
TYPEX_MCP_URL=http://127.0.0.1:52222/mcp/
TYPEX_REQUEST_TIMEOUT_SECONDS=15
# Defaults are for mock/dev. First live TypeX DB import (explicit approval only): 2 chats / 5 messages, OpenRouter off.
TYPEX_SYNC_CHAT_LIMIT=20
TYPEX_SYNC_MESSAGE_LIMIT=50

# Fill these after running TypeX MCP discovery.
# Do not guess tool names.
TYPEX_CHATS_TOOL=
TYPEX_MESSAGES_TOOL=
TYPEX_CURRENT_USER_TOOL=
TYPEX_SENDER_TOOL=

# Optional. Inbox attachments: list files in a chat, then Save As into data/attachments.
# Never send or upload.
# TYPEX_FILES_LIST_TOOL=typex.list_chat_downloadable_files
# TYPEX_FILE_SAVE_TOOL=typex.download_chat_file

# Exact TypeX profile display name of the logged-in operator. Used only for
# outgoing detection when records have send_name but no stable sender id.
# TYPEX_SELF_DISPLAY_NAME=

# mock | real — real uses a Telegram USER ACCOUNT (MTProto), not Bot API.
# For real mode fill API_ID/API_HASH from my.telegram.org, then authorize once:
#   cd backend && python -m app.integrations.telegram_auth
TELEGRAM_MODE=mock
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/telegram.session
# First live Telegram import: 2 chats / 5 messages, OpenRouter off.
TELEGRAM_SYNC_CHAT_LIMIT=20
TELEGRAM_SYNC_MESSAGE_LIMIT=50

# mock | real | browser
SLACK_MODE=mock
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=
# Local app token for the Chrome/Edge Slack Browser Reader. Not a Slack credential.
# Generated automatically into data/slack_browser_token when SLACK_MODE=browser if empty.
SLACK_BROWSER_LOCAL_TOKEN=
SLACK_SYNC_CHAT_LIMIT=10
SLACK_SYNC_MESSAGE_LIMIT=20
SLACK_DOWNLOAD_FILES=true

# Slack display name of the logged-in operator. Used when Browser Reader
# cannot prove direction from Slack user ids. Spelling variants of
# Igor Amchislavskii are recognized even without this setting.
# SLACK_SELF_DISPLAY_NAME=Igor Amchislavskii

# Experimental Windows Slack Desktop notification capture. Independent of SLACK_MODE.
# Does not use a Slack App, OAuth, or Slack tokens. Local helper secret only.
SLACK_NOTIFICATION_CAPTURE_ENABLED=false
SLACK_NOTIFICATION_LOCAL_TOKEN=
# Optional comma-separated PackageFamilyName / AppUserModelId fragments for this PC's Slack Desktop.
SLACK_NOTIFICATION_SOURCE_IDS=

# Automatic background sync (read-only). The backend scheduler syncs TypeX and
# Telegram on a timer so the Inbox updates without pressing Sync. Slack does not
# use this 30-second history poll: new Slack messages arrive via Socket Mode.
# It never calls AI, never sends anything, and never marks Telegram chats as read.
# Manual Sync buttons keep working and can be used while auto sync is off.
AUTO_SYNC_ENABLED=false
# Delay between full scheduler cycles. A new cycle starts only after the previous one ends.
AUTO_SYNC_INTERVAL_SECONDS=30
# Cap for the exponential backoff applied after consecutive failures.
AUTO_SYNC_MAX_BACKOFF_SECONDS=300
# Hard limit for a single platform sync. On timeout the platform is marked failed and
# the other platform still runs.
AUTO_SYNC_PLATFORM_TIMEOUT_SECONDS=60

# Automatic Russian translation. Reuses OPENROUTER_API_KEY / OPENROUTER_MODEL.
# Does not change AI analysis, drafts, or messenger sync. No history backfill.
AUTO_TRANSLATE_ENABLED=true
TRANSLATION_TARGET_LANGUAGE=ru
TRANSLATION_MIN_TEXT_LENGTH=4
TRANSLATION_MAX_CHARS=6000
TRANSLATION_CONCURRENCY=2
# mock | openrouter
TRANSLATION_PROVIDER=openrouter

# SQLite file is created automatically at data/traffic_manager.db
# DATABASE_URL=sqlite:///C:/Users/arman/cas/data/traffic_manager.db

# mock | openrouter
AI_PROVIDER=mock
# AI_PROVIDER=openrouter

# Digest Review / Q&A only. Does not change inbox analysis, drafts, or translation.
DIGEST_REVIEW_DEFAULT_MODEL=anthropic/claude-opus-5
DIGEST_QA_DEFAULT_MODEL=anthropic/claude-sonnet-4.6

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_API_KEY=
