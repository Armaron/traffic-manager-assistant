# Copy this file to .env and fill in local values.
# Never commit .env or put API keys in the frontend.

APP_NAME=Traffic Manager Assistant
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# mock | real  (real TypeX is Phase 8; keep mock until then)
TYPEX_MODE=mock
# Official TypeX Desktop MCP endpoint. Used only when TYPEX_MODE=real.
# TYPEX_MCP_URL=http://127.0.0.1:52222/mcp/

# SQLite file is created automatically at data/traffic_manager.db
# DATABASE_URL=sqlite:///C:/Users/arman/cas/data/traffic_manager.db

# mock | openrouter
AI_PROVIDER=mock
# AI_PROVIDER=openrouter

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_API_KEY=
